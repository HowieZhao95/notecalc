{
  "name": "notecalc",
  "version": "0.3.2",
  "description": "Markdown calculator with a shared Obsidian runtime",
  "main": "dist/notecalc-core.mjs",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && python3 tools/package_release.py",
    "pretest": "npm run build"
  },
  "keywords": [],
  "author": "HowieZhao95",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "exports": {
    ".": "./dist/notecalc-core.mjs"
  },
  "homepage": "https://github.com/HowieZhao95/notecalc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HowieZhao95/notecalc.git"
  },
  "bugs": {
    "url": "https://github.com/HowieZhao95/notecalc/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
